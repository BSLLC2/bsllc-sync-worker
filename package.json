{
  "name": "bsllc-sync-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted sync worker: pulls metrics from source APIs (v1: Google Ads) and feeds the BS LLC Account Health dashboard via `npm run sync`. Holds all third-party credentials; the only place tokens ever live.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "mint-token": "tsx src/mint-refresh-token.ts",
    "import-csv": "tsx src/import-csv.ts",
    "import-hubspot": "tsx src/import-hubspot.ts",
    "import-och": "tsx src/import-och.ts",
    "import-web-inquiries": "tsx src/import-web-inquiries.ts",
    "import-offline-conversions": "tsx src/import-offline-conversions.ts",
    "import-ga4": "tsx src/import-ga4.ts",
    "import-gsc-api": "tsx src/import-gsc-api.ts",
    "import-d365": "tsx src/import-d365.ts",
    "verify-d365": "tsx src/verify-d365.ts",
    "import-email": "tsx src/import-email.ts",
    "import-seo": "tsx src/import-seo.ts",
    "import-aeo": "tsx src/import-aeo.ts",
    "import-webops": "tsx src/import-webops.ts",
    "snapshot-mrr": "tsx src/snapshot-mrr.ts",
    "send-notifications": "tsx src/send-notifications.ts",
    "send-outbound-emails": "tsx src/send-outbound-emails.ts",
    "send-push": "tsx src/send-push.ts",
    "send-team-notifications": "tsx src/send-team-notifications.ts",
    "send-task-digest": "tsx src/send-task-digest.ts",
    "post-to-slack": "tsx src/post-to-slack.ts",
    "send-sms": "tsx src/send-sms.ts",
    "import-hubspot-deals": "tsx src/import-hubspot-deals.ts",
    "apply-tasks-csv": "tsx src/apply-tasks-csv.ts",
    "seed-client-visibility": "tsx src/seed-client-visibility.ts",
    "enable-signoff": "tsx src/enable-signoff.ts",
    "share-meeting": "tsx src/share-meeting.ts",
    "dump-client-metrics": "tsx src/dump-client-metrics.ts",
    "import-qbo-invoices": "tsx src/import-qbo-invoices.ts",
    "verify-qbo": "tsx src/verify-qbo.ts",
    "verify-slack": "tsx src/verify-slack.ts",
    "verify-dataforseo": "tsx src/verify-dataforseo.ts",
    "verify-webops": "tsx src/verify-webops.ts",
    "run-research": "tsx src/run-research.ts",
    "upload-to-drive": "tsx src/upload-to-drive.ts",
    "heartbeat": "tsx src/heartbeat.ts",
    "monitor-freshness": "tsx src/monitor-freshness.ts",
    "backfill": "tsx src/index.ts --mode=backfill",
    "incremental": "tsx src/index.ts --mode=incremental",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "google-ads-api": "^24.1.0",
    "google-auth-library": "^11.0.0",
    "pg": "^8.22.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
