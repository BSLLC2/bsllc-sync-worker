# ── Copy to .env and fill in. NEVER commit .env. ────────────────────────────
# These four Google Ads values are the ONLY secrets in the whole pipeline.
# They live here on the VPS and nowhere else.

# From Google Cloud Console → OAuth client (Desktop app type).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# From your MCC → Tools → API Center. Must have STANDARD access to pull real data.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Minted once with `npm run mint-token` (run it on a machine with a browser).
GOOGLE_ADS_REFRESH_TOKEN=

# Your MCC (manager) account ID, DIGITS ONLY. This is the "BS LLC · Manager"
# account — 214-171-2409 → 2141712409.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=2141712409

# ── Neon Postgres (READ-ONLY use here — the worker only reads connector_mappings) ──
# Same database the dashboard uses. Prefer a read-only role if you have one.
DATABASE_URL=

# ── Where the dashboard checkout lives, so the worker can shell out to
# `npm run sync`. This checkout needs its own DATABASE_URL and nothing else. ──
DASHBOARD_DIR=/home/YOUR_USER/bsllc-account-health

# ── QuickBooks Online (Quote Designer → estimate on signature) ──────────────
# From the Intuit app's Keys page. QBO rotates the refresh token on use; the
# worker persists the latest one in Postgres (integration_tokens), seeding from
# QBO_REFRESH_TOKEN only on the first run.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_ENV=sandbox            # sandbox | production
QBO_DEFAULT_ITEM_ID=1      # QBO Item id to bill lines against (sandbox "1" = Services)
QBO_AUTO_INVOICE=false     # true = also create (and email) a real invoice on signature, not just an estimate

# ── DataForSEO (SEO rank + AEO / AI-visibility) ─────────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Web push (browser notifications for client comments) ────────────────────
# Generate once:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY also goes in the dashboard's env (server reads it for the
# subscribe flow); the private key lives ONLY here in the worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:digital@bsllc.biz
