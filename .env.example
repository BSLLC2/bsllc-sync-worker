# ── Copy to .env and fill in. NEVER commit .env. ────────────────────────────
# These four Google Ads values are the ONLY secrets in the whole pipeline.
# They live here on the VPS and nowhere else.

# From Google Cloud Console → OAuth client (Desktop app type).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# From your MCC → Tools → API Center. Must have STANDARD access to pull real data.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Minted once with `npm run mint-token` (run it on a machine with a browser).
GOOGLE_ADS_REFRESH_TOKEN=

# Your MCC (manager) account ID, DIGITS ONLY. This is the "BS LLC · Manager"
# account — 214-171-2409 → 2141712409.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=2141712409

# ── Neon Postgres (READ-ONLY use here — the worker only reads connector_mappings) ──
# Same database the dashboard uses. Prefer a read-only role if you have one.
DATABASE_URL=

# ── Where the dashboard checkout lives, so the worker can shell out to
# `npm run sync`. This checkout needs its own DATABASE_URL and nothing else. ──
DASHBOARD_DIR=/home/YOUR_USER/bsllc-account-health

# ── QuickBooks Online (Quote Designer → estimate on signature) ──────────────
# From the Intuit app's Keys page. QBO rotates the refresh token on use; the
# worker persists the latest one in Postgres (integration_tokens), seeding from
# QBO_REFRESH_TOKEN only on the first run.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_ENV=sandbox            # sandbox | production
QBO_DEFAULT_ITEM_ID=1      # QBO Item id to bill lines against (sandbox "1" = Services)

# ── DataForSEO (SEO rank + AEO / AI-visibility) ─────────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Web push (browser notifications for client comments) ────────────────────
# Generate once:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY also goes in the dashboard's env (server reads it for the
# subscribe flow); the private key lives ONLY here in the worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:digital@bsllc.biz

# ── Dialpad (two-way client calling + SMS) ──────────────────────────────────
# Drains sms_messages (send-sms.ts). Dormant until this key is set: with it
# unset the job logs and exits 0 (nothing sent). Dialpad uses a Bearer token
# (Authorization: Bearer <key>). Each teammate's own Dialpad number + user id
# is stored on the dashboard user (Settings); send-sms.ts joins on user_email
# to look up the Dialpad user id at send time.
DIALPAD_API_KEY=
# Optional: shared secret used to verify the dashboard's public webhook (HS256
# JWT signature) — dormant-ready, does not hard-block when unset or when the
# verification can't be confirmed. Set the same value on the dashboard app's
# DIALPAD_WEBHOOK_SECRET env var.
DIALPAD_WEBHOOK_SECRET=

# ── Slack (two-way client Slack tab) ────────────────────────────────────────
# Bot token for a Slack app with chat:write, users:read, and the
# message.channels (or message.groups, for private channels) Event
# Subscription. The bot must be invited into each client's channel. Drains
# client_slack_posts (post-to-slack.ts) and keeps slack_user_cache warm
# (sync-slack-users.ts). Dormant until set: jobs log and exit 0.
SLACK_BOT_TOKEN=
# NOT a worker secret — SLACK_SIGNING_SECRET goes on the DASHBOARD app's Vercel
# env (it verifies the inbound webhook the app receives directly from Slack's
# Events API at /api/webhooks/slack). Point the Slack app's Event Subscriptions
# URL at https://bsllc-account-health.vercel.app/api/webhooks/slack.
